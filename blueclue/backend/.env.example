# Backend Environment Variables Example
# Copy this file to .env and fill in the values before running the backend server.

PORT=3000
NODE_ENV=development

# Frontend 
#By default, Vite uses port 5173
FRONTEND_URL=http://localhost:5173

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=blueclue
DB_PASSWORD=your_postgres_password_here
DB_PORT=5432

# JWT Secret for token signing
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=blueclue-secret-key-change-in-production

# Email Service Configuration (Optional - for sending transactional emails)
# If not configured, email service will run in development mode (logs to console)
# For Gmail: Use App Password (not your regular password)
# Tutorial: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=BlueClue Support <noreply@blueclue.com>

# Inbound Email Configuration (Optional - for email-to-ticket feature)
# Webhook signing key from Mailgun for validating incoming webhooks
# 
# DEVELOPMENT SETUP (each developer):
#   1. Create your own FREE Mailgun sandbox account at mailgun.com
#   2. Get your webhook signing key: Mailgun Dashboard > Settings > Webhooks > HTTP webhook signing key
#   3. Copy this .env.example to .env and add YOUR personal signing key below
#
# PRODUCTION SETUP:
#   - Use ONE shared Mailgun account for the team
#   - Store the signing key in your deployment platform's environment variables
#   - Never commit production keys to git
#
# Note: Without this key, signature validation is skipped (development mode only)
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key-here

