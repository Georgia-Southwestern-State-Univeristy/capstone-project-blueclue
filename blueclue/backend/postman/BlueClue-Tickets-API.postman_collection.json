{
	"info": {
		"_postman_id": "blueclue-tickets-api",
		"name": "BlueClue Tickets API",
		"description": "API collection for testing BlueClue ticket CRUD endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Ticket - Valid",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has success status\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"});",
							"",
							"pm.test(\"Ticket was created\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property(\"id\");",
							"    pm.expect(jsonData.data).to.have.property(\"subject\");",
							"    pm.expect(jsonData.data).to.have.property(\"description\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"subject\": \"Test Ticket - Technical Issue\",\n    \"description\": \"Unable to connect to the office network from my laptop\",\n    \"customer_id\": 1,\n    \"priority\": \"high\",\n    \"category\": \"technical\"\n}"
				},
				"url": {
					"raw": "http://localhost:3000/api/tickets",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3000",
					"path": [
						"api",
						"tickets"
					]
				}
			},
			"response": []
		},
