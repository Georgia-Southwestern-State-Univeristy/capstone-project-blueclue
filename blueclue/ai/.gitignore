# ── Generated ML data artifacts ──────────────────────────────────
# These are regenerated by scripts/prepare_ml_data.py and should
# never be committed (some exceed GitHub's 100 MB file size limit).

# Pre-computed feature matrices (can be 100-900 MB each)
data/features/*.npz
data/features/feature_extractor.pkl

# Raw & augmented data files (large generated CSVs / merged JSON)
data/raw/augmented_external_tickets.csv
data/raw/synthetic_tickets_merged.json

# Preprocessed / split data (generated, not source)
data/processed/
data/splits/train.json
data/splits/val.json
data/splits/test.json

# EDA visualizations (binary, regeneratable)
data/reports/visualizations/

# Training logs (verbose JSON produced during each run)
models/training_log_*.json
models/priority_training_log_*.json

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Environment
.env
*.env
