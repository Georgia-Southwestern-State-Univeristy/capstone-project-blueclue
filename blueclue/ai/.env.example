# BlueClue ML Inference Service Configuration
# =============================================
# Copy this file to .env and adjust as needed.
# In Railway: add these under the ml-service service (root dir: blueclue/ai)

# ─── Server ──────────────────────────────────────────────────────────────────
ML_SERVICE_PORT=5000
ML_SERVICE_HOST=0.0.0.0

# Environment (development, production)
ML_ENV=development

# Uvicorn workers (increase for production)
ML_WORKERS=2

# Model confidence threshold (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.5

# Prediction cache settings
CACHE_MAX_SIZE=1024
CACHE_TTL_SECONDS=3600

# ─── Database (required for RAG / vector search) ─────────────────────────────
# Railway auto-injects DATABASE_URL for the Postgres plugin.
# For local dev: copy from your Railway service's Variables tab.
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── LLM — OpenAI (required for GPT responses + ada-002 embeddings) ──────────
# Get your key at: https://platform.openai.com/api-keys
# Leave blank to fall back to MiniLM (free local embeddings, no chat generation)
OPENAI_API_KEY=sk-...

# Chat model: gpt-3.5-turbo (cheap), gpt-4o-mini (balanced), gpt-4-turbo (best)
LLM_MODEL=gpt-3.5-turbo

# Response tuning
LLM_TEMPERATURE=0.7      # 0.0 = deterministic, 1.0 = creative
LLM_MAX_TOKENS=250       # Keep responses concise
LLM_TIMEOUT_SEC=15       # Hard timeout per request
LLM_MAX_RETRIES=2        # Retries on transient OpenAI errors

# Azure OpenAI (optional — leave blank to use standard OpenAI)
# LLM_BASE_URL=https://your-resource.openai.azure.com/

# ─── Embeddings ───────────────────────────────────────────────────────────────
# text-embedding-ada-002 = 1536-dim (OpenAI, $0.0001/1K tokens)
# all-MiniLM-L6-v2       = 384-dim  (free, local, no API key needed)
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIM=1536

# ─── RAG Pipeline ─────────────────────────────────────────────────────────────
RAG_TOP_K=5              # Number of KB articles to retrieve per query
RAG_MIN_SIMILARITY=0.35  # Minimum cosine similarity to include an article (0–1)
RAG_CACHE_TTL=3600       # Cache LLM responses for N seconds (0 to disable)
